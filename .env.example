# Skylyt TravelHub Backend - Environment Variables Template
# Copy this file to .env and fill in real values:  cp .env.example .env
# Never commit .env to git.

# =========================
# Database
# =========================
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/skylyt_db

# =========================
# Redis / Dragonfly
# =========================
DRAGONFLY_URL=redis://localhost:6379/0

# =========================
# JWT / Auth
# =========================
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# Email (SMTP)
# =========================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@skylytluxury.com

# =========================
# Frontend
# =========================
FRONTEND_URL=https://skylyt.scaleitpro.com

# =========================
# Payment Gateways
# =========================
STRIPE_SECRET_KEY=sk_test_...

FLUTTERWAVE_SECRET_KEY=FLWSECK-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...

PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=True

# =========================
# Travel APIs (optional)
# =========================
BOOKING_COM_API_KEY=
EXPEDIA_API_KEY=
HERTZ_API_KEY=

# =========================
# Email (Resend)
# =========================
RESEND_API_KEY=

# =========================
# Exchange Rate
# =========================
EXCHANGE_RATE_API_KEY=

# =========================
# Environment
# =========================
ENVIRONMENT=production
DEBUG=False
